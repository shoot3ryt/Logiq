# Logiq — variabili d'ambiente
# Compila i valori e carica il file nella cartella principale del server su Wispbyte
# (accanto a main.py). Non committare mai questo file: è già in .gitignore.

# --- Discord (obbligatorio) ---
# Portale Developer -> la tua app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=INSERISCI_IL_TOKEN_DEL_BOT

# --- Database (obbligatorio) ---
# Se la password contiene @ : / ? # % va codificata in URL (es. @ diventa %40)
MONGODB_URI=mongodb+srv://UTENTE:PASSWORD@NOME-CLUSTER.mongodb.net/

# --- Discord OAuth2 (Client ID: usato già ora per il link di invito) ---
# Portale Developer -> la tua app -> OAuth2 -> Client ID
DISCORD_CLIENT_ID=INSERISCI_IL_CLIENT_ID

# --- Fase 2: login con Discord e admin panel (non ancora usate dal codice) ---
# Client Secret: portale Developer -> OAuth2 -> Reset Secret
DISCORD_CLIENT_SECRET=
# Il tuo ID utente Discord (modalità sviluppatore -> tasto destro su di te -> Copia ID)
OWNER_ID=
# Stringa casuale lunga per firmare le sessioni (es. generata con: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=

# --- Generale ---
ENVIRONMENT=production
